{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "get-bridges",
    "description": "A list summarizing all bridges available in the system",
    "type": "object",
    "properties": {
        "LastUpdate": {
            "description": "Integer value representing the timestamp of the last status update for the data",
            "type": "integer"
        },
        "bridges": {
            "description": "Wrapper array for all listed bridges",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "description": "ID number of the listed bridge",
                        "type": "string",
                    },
                    "name": {
                        "description": "Name of the bridge",
                        "type": "string"
                    },
                    "region": {
                        "description": "Description of the region or neighborhood that the bridge serves",
                        "type": "string"
                    },
                    "latitude": {
                        "description": "Latitude coordinate of this bridge",
                        "type": "number"
                    },
                    "longitude": {
                        "description": "Longitude coordinate of this bridge",
                        "type": "number"
                    },
                    "staticimg": {
                        "description": "URL of a static image for a bridge",
                        "type": "string"
                    },
                    "liveimg": {
                        "description": "URL of a live image for a bridge",
                        "type": "string"
                    },
                    "bridge_type": {
                        "description": "Type of bridge",
                        "type": "string"
                    },
                    "short_name": {
                        "description": "Shortened name for optional use on smaller screens",
                        "type": "string"
                    },
                    "status": {
                        "description": "Status of a movable bridge, either Up, Down, or Unknown",
                        "type": "string"
                    }
                }
            }
        }
    }
}
