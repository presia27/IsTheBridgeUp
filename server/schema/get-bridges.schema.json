{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "get-bridges",
    "description": "A list summarizing all bridges available in the system",
    "type": "object",
    "properties": {
        "bridges": {
            "description": "Wrapper array for all listed bridges",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "description": "ID number of the listed bridge",
                        "type": "string",
                    },
                    "name": {
                        "description": "Name of the bridge",
                        "type": "string"
                    },
                    "region": {
                        "description": "Description of the region or neighborhood that the bridge serves",
                        "type": "string"
                    }
                }
            }
        }
    }
}
